## RT Lock system

# Door/container messages
rt-lock-door-locked = The door is locked.

# Key messages
rt-lock-key-unlock = You turn the key and unlock it.
rt-lock-key-lock = You turn the key and lock it.
rt-lock-key-wrong = This key doesn't fit this lock.
rt-lock-keyring-no-match = None of your keys fit this lock.

# Lockpick messages
rt-lockpick-start = You begin working the lockpick into the lock...
rt-lockpick-success = The lock clicks open! ({$successes}/{$needed} successes)
rt-lockpick-fail = The lockpick slips — failed. ({$successes}/{$needed} successes)
rt-lockpick-break = The lockpick snaps!

# Lock type names
rt-lock-type-tavern = Tavern lock
rt-lock-type-house = House lock
rt-lock-type-cell = Cell lock
rt-lock-type-barracks = Barracks lock
rt-lock-type-treasury = Treasury lock
rt-lock-type-armory = Armory lock
